[Unit]
Description=Backeddy: primeiro boot (prepara os discos de backup, Samba e Kopia)
After=network-online.target local-fs.target systemd-udev-settle.service
Wants=network-online.target
# pendrive: o instalador grava o firstboot.env; máquina virtual: vem no disquinho BACKEDDYCFG
ConditionPathExists=|/etc/backeddy/firstboot.env
ConditionPathExists=|/etc/backeddy-vm

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/backeddy-server/bin/backeddy-firstboot
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target
