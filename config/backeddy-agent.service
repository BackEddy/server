[Unit]
Description=Backeddy: vigia (alertas com bipe até alguém reconhecer)
# não esperar o multi-user.target: o primeiro boot liga este serviço antes de o boot terminar
After=network.target
ConditionPathExists=/etc/backeddy/server.conf

[Service]
ExecStart=/usr/local/sbin/backeddy-agent
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
