#!/bin/bash
# backeddy — comandos do Backeddy Server
#   backeddy status            situação do servidor
#   backeddy add-pc NOME       autoriza um PC Windows a fazer backup (Kopia); --json para o app
#   backeddy pcs               PCs autorizados · backeddy remove-pc NOME tira o acesso (backups ficam)
#   backeddy passwd            troca a senha usada pelos Macs
#   backeddy replace-disk NOVO [ANTIGO]   troca um disco do espelho (morto ou com defeito)
#   backeddy add-disk NOVO     acrescenta um disco e passa a espelhar os backups
#   backeddy mirror            liga o espelho (cada arquivo em 2 discos), se houver espaço
#   backeddy unmirror          desliga o espelho: mais espaço, SEM proteção
#   backeddy space             recalcula a divisão do espaço entre Macs e PCs (automático, a cada hora)
#   backeddy alerts            alertas ativos (o servidor bipa até alguém reconhecer)
#   backeddy ack [DIAS]        reconhece os alertas: para de bipar e lembra de novo em DIAS (padrão 1)
#   backeddy quiet INÍCIO FIM  silêncio à noite (ex.: 22 8) · backeddy quiet off
#   backeddy issue             atualiza a tela do monitor do servidor (situação + como conectar)
#   backeddy wifi              escolhe a rede Wi-Fi (no próprio servidor, com teclado e monitor)
set -euo pipefail
ETC=/etc/backeddy; DATA=/srv/backeddy; KCONF=$ETC/kopia
[ "$(id -u)" = 0 ] || { echo "Use: sudo backeddy $*"; exit 1; }
. "$ETC/server.conf"
# Idioma escolhido no instalador (UI_LANG em server.conf): pt, en ou es.
# m PT EN ES escreve o texto no idioma; mf PT EN ES ARGS... faz o mesmo com printf (%s).
UI=${UI_LANG:-pt}
m() { case "$UI" in en) printf '%s' "$2" ;; es) printf '%s' "$3" ;; *) printf '%s' "$1" ;; esac; }
mf() { local f; f=$(m "$1" "$2" "$3"); shift 3; # shellcheck disable=SC2059
  printf "$f" "$@"; }
kenv() {
  export KOPIA_CONFIG_PATH="$KCONF/repository.config" KOPIA_CACHE_DIRECTORY=/var/cache/backeddy-kopia KOPIA_LOG_DIR=/var/log/backeddy-kopia
  export KOPIA_PASSWORD; KOPIA_PASSWORD=$(cat "$KCONF/repo-password")
}
svc() {
  case "$(systemctl is-active "$1" 2>/dev/null)" in
    active) echo "$I_OK $2" ;;
    activating) echo "$I_WAIT $2 $(m '(aguardando os discos de backup…)' '(waiting for the backup disks…)' '(esperando los discos de backup…)')" ;;
    *) echo "$I_BAD $2 $(mf '(parado: sudo systemctl status %s)' '(stopped: sudo systemctl status %s)' '(detenido: sudo systemctl status %s)' "$1")" ;;
  esac
}
# No monitor do próprio servidor (console) não existem emojis: usa cores e texto.
W=$(m 'AVISO ' ' WARN ' 'AVISO '); B=$(m ' ERRO ' ' FAIL ' 'ERROR ')   # marcas do console (a tela usa para o título)
if [ "${TERM:-}" = linux ] || [ -n "${BACKEDDY_PLAIN:-}" ]; then
  I_OK=$'\e[1;32m[  OK  ]\e[0m'; I_WARN=$'\e[1;33m['"$W"$']\e[0m'; I_BAD=$'\e[1;31m['"$B"$']\e[0m'
  I_WAIT=$'\e[1;36m[ .... ]\e[0m'; I_OFF=$'\e[2m[  --  ]\e[0m'; I_HEAD='  '; I_DISK='        '; I_KEY='        '; I_DONE=$'\e[1;32m[  OK  ]\e[0m'
  IND='        '
else
  I_OK='🟢'; I_WARN='🟡'; I_BAD='🔴'; I_WAIT='⏳'; I_OFF='⚪'; I_HEAD='🌀'; I_DISK='💾'; I_KEY='🔐'; I_DONE='✅'
  IND='  '
fi
# Divisão automática do espaço: os PCs (Kopia) usam o que precisam; o Time Machine fica com o
# resto, menos uma folga (10% do espaço útil, ou 20 GB se couber), e nunca menos de 20%.
# Roda a cada hora (backeddy-space.timer) e depois de mudar discos ou espelho.
SPACE=/var/lib/backeddy/space
tm_limit() {
  local used free usable kp reserve floor limit gb tight=0 cur twenty
  mountpoint -q "$DATA" || return 0
  if [ "$(findmnt -no FSTYPE "$DATA")" = btrfs ]; then
    read -r used free < <(btrfs filesystem usage -b "$DATA" 2>/dev/null | awk '
      /^Data,/ { if (match($0, /Used:[0-9]+/)) u += substr($0, RSTART + 5, RLENGTH - 5) }
      /Free \(estimated\):/ { f = $3 }
      END { print u + 0, f + 0 }')
    usable=$((used + free))
  else
    usable=$(df -Pk "$DATA" | awk 'NR==2 {print $2 * 1024}')
  fi
  kp=$(du -sb "$DATA/kopia" 2>/dev/null | cut -f1); kp=${kp:-0}
  reserve=$(( usable / 10 )); twenty=$(( 20 * 1024 * 1024 * 1024 ))
  [ "$reserve" -lt "$twenty" ] && [ "$twenty" -le $(( usable / 5 )) ] && reserve=$twenty
  floor=$(( usable / 5 ))
  limit=$(( usable - kp - reserve ))
  if [ "$limit" -lt "$floor" ]; then limit=$floor; tight=1; fi
  gb=$(( limit / 1024 / 1024 / 1024 )); [ "$gb" -lt 1 ] && gb=1
  install -d -m 0755 "$(dirname "$SPACE")"
  printf 'USABLE=%s\nKOPIA=%s\nTM_LIMIT=%s\nTIGHT=%s\n' "$usable" "$kp" "$((gb * 1024 * 1024 * 1024))" "$tight" > "$SPACE"
  cur=$(awk -F'= *' '/fruit:time machine max size/ {print $2; exit}' /etc/samba/smb.conf)
  if [ "$cur" != "${gb}G" ]; then
    sed -i "s|^\([[:space:]]*fruit:time machine max size = \).*|\1${gb}G|" /etc/samba/smb.conf
    systemctl reload smbd >/dev/null 2>&1 || systemctl restart smbd >/dev/null 2>&1 || true
  fi
  [ "${1:-}" = quiet ] || mf '   Limite do Time Machine agora: %s GB (PCs usam %s)\n' '   Time Machine limit now: %s GB (PCs use %s)\n' '   Límite de Time Machine ahora: %s GB (los PC usan %s)\n' "$gb" "$(human "$kp")"
}
human() { numfmt --to=iec --suffix=B "$1" 2>/dev/null || echo "$1"; }

# ---------- Rede (cabo ou Wi-Fi) ----------
wifi_if() { local w; w=$(ls -d /sys/class/net/*/wireless 2>/dev/null | head -1); [ -n "$w" ] && basename "$(dirname "$w")"; return 0; }
net_dev() { ip -4 route show default 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit }}' || true; }
net_status() {
  local dev ssid sig pct
  dev=$(net_dev)
  if [ -z "$dev" ]; then
    echo "$I_BAD $(m 'Sem rede: os Macs e PCs não alcançam o servidor' 'No network: the Macs and PCs can'"'"'t reach the server' 'Sin red: los Mac y PC no llegan al servidor')"
    if [ -n "$(wifi_if)" ]; then
      echo "$IND $(m 'Wi-Fi: com teclado e monitor neste servidor, entre como admin e rode: sudo backeddy wifi' 'Wi-Fi: with a keyboard and screen on this server, log in as admin and run: sudo backeddy wifi' 'Wi-Fi: con teclado y monitor en este servidor, entra como admin y ejecuta: sudo backeddy wifi')"
    else
      echo "$IND $(m 'Ligue o cabo de rede no roteador.' 'Plug the network cable into the router.' 'Conecta el cable de red al router.')"
    fi
    return 0
  fi
  if [ -d "/sys/class/net/$dev/wireless" ]; then
    IFS=$'\t' read -r ssid sig < <(iw dev "$dev" link 2>/dev/null | awk '
      /^[[:space:]]*SSID:/ { sub(/^[[:space:]]*SSID: /, ""); s = $0 }
      /^[[:space:]]*signal:/ { g = $2 }
      END { printf "%s\t%s\n", s, g }') || true
    sig=${sig%.*}; [ -n "$sig" ] || sig=-100
    pct=$(( 2 * (sig + 100) )); [ "$pct" -gt 100 ] && pct=100; [ "$pct" -lt 0 ] && pct=0
    if [ "$pct" -lt 35 ]; then
      echo "$I_WARN $(mf 'Rede: Wi-Fi "%s" · sinal fraco (%s%%): backups lentos. Aproxime do roteador ou use cabo' 'Network: Wi-Fi "%s" · weak signal (%s%%): slow backups. Move it closer to the router or use a cable' 'Red: Wi-Fi "%s" · señal débil (%s%%): backups lentos. Acércalo al router o usa cable' "$ssid" "$pct")"
    else
      echo "$I_OK $(mf 'Rede: Wi-Fi "%s" · sinal %s%%' 'Network: Wi-Fi "%s" · signal %s%%' 'Red: Wi-Fi "%s" · señal %s%%' "$ssid" "$pct")"
    fi
  else
    echo "$I_OK $(mf 'Rede: cabo (%s)' 'Network: cable (%s)' 'Red: cable (%s)' "$dev")"
  fi
}
# lista "sinal<TAB>com_senha<TAB>nome", uma por rede (a mais forte), da melhor para a pior
wifi_scan() {
  iw dev "$1" scan 2>/dev/null | awk '
    function emit() {
      if (s == "" || s ~ /\\x00/ || ent) return
      p = int(2 * (sig + 100)); if (p > 100) p = 100; if (p < 0) p = 0
      if (!(s in best) || p > best[s]) { best[s] = p; sec[s] = enc }
    }
    /^BSS / { emit(); s = ""; sig = -100; enc = 0; ent = 0; next }
    /^[[:space:]]+SSID: / { s = $0; sub(/^[[:space:]]+SSID: /, "", s) }
    /^[[:space:]]+signal: / { sig = $2 }
    /^[[:space:]]+(RSN|WPA):/ { enc = 1 }
    /capability:.*Privacy/ { enc = 1 }
    /Authentication suites:.*802\.1X/ && !/PSK|SAE/ { ent = 1 }
    END { emit(); for (k in best) printf "%d\t%d\t%s\n", best[k], sec[k], k }' | sort -t$'\t' -k1,1nr
}
save_wifi_cfg() {   # cópia das redes nos discos de backup (para o "Recuperar o servidor")
  [ -f "$ETC/disks.conf" ] && mountpoint -q "$DATA" || return 0
  install -d -m 0700 "$DATA/.backeddy/iwd"
  for f in /var/lib/iwd/*; do [ -f "$f" ] && install -m 0600 "$f" "$DATA/.backeddy/iwd/"; done
  return 0
}

# ---------- Bateria (notebook como servidor) ----------
BAT=$(ls -d /sys/class/power_supply/BAT* 2>/dev/null | head -1 || true)
on_battery() {   # 0 = sem energia na tomada, rodando na bateria
  [ -n "$BAT" ] || return 1
  local a
  for a in /sys/class/power_supply/*; do
    [ "$(cat "$a/type" 2>/dev/null)" = Mains ] && [ "$(cat "$a/online" 2>/dev/null)" = 0 ] && return 0
  done
  [ "$(cat "$BAT/status" 2>/dev/null)" = Discharging ]
}
bat_pct() { cat "$BAT/capacity" 2>/dev/null || echo "?"; }

case "${1:-status}" in
  status)
    echo "$I_HEAD $NAME  ·  $SLUG.local  ·  $(hostname -I | awk '{print $1}')  ·  Backeddy Server $VERSION"
    echo
    net_status
    if [ -n "$BAT" ]; then
      if on_battery; then
        echo "$I_BAD $(mf 'Sem energia na tomada: rodando na bateria (%s%%). Desliga sozinho, com segurança, em 10%%' 'No wall power: running on battery (%s%%). Shuts down safely by itself at 10%%' 'Sin corriente: funcionando con batería (%s%%). Se apaga solo, con seguridad, al 10%%' "$(bat_pct)")"
      else
        echo "$I_OK $(mf 'Bateria: %s%% · na tomada (a bateria funciona como nobreak)' 'Battery: %s%% · plugged in (the battery works as a UPS)' 'Batería: %s%% · enchufado (la batería funciona como SAI)' "$(bat_pct)")"
      fi
    fi
    svc smbd "Time Machine (Samba)"
    svc avahi-daemon "$(m 'Anúncio na rede (Avahi)' 'Network announcement (Avahi)' 'Anuncio en la red (Avahi)')"
    svc backeddy-kopia "Kopia Server (PCs)"
    if [ -s /run/backeddy/alerts ]; then
      while IFS='|' read -r _ txt; do echo "$I_BAD $(m 'ALERTA' 'ALERT' 'ALERTA'): $txt"; done < /run/backeddy/alerts
      echo "$IND $(m 'O servidor está bipando. Para parar: sudo backeddy ack (ou aperte uma tecla no servidor)' 'The server is beeping. To stop it: sudo backeddy ack (or press a key on the server)' 'El servidor está pitando. Para detenerlo: sudo backeddy ack (o pulsa una tecla en el servidor)')"
    fi
    if [ -f "$ETC/disks.conf" ]; then
      if mountpoint -q "$DATA"; then
        SHOW=$(btrfs filesystem show "$DATA" 2>/dev/null)
        PROF=$(btrfs filesystem df "$DATA" 2>/dev/null | awk -F'[ ,:]+' '/^Data/{print $2; exit}')
        NDEV=$(echo "$SHOW" | grep -c '^[[:space:]]*devid' || true)
        MISSING=$(echo "$SHOW" | grep -ci 'missing' || true)
        ERRS=$(btrfs device stats "$DATA" 2>/dev/null | awk '$2 != 0 {n++} END {print n+0}')
        MARK=$I_OK
        case "$PROF" in
          RAID1*) LAYOUT=$(mf 'Espelho de %s discos' 'Mirror of %s disks' 'Espejo de %s discos' "$NDEV") ;;
          *)
            if [ "$NDEV" -eq 1 ] && systemd-detect-virt -q 2>/dev/null; then
              LAYOUT=$(m 'Disco da máquina virtual (a proteção contra disco quebrado é a dos discos do Windows)' 'Virtual machine disk (protection against a broken disk comes from the Windows disks)' 'Disco de la máquina virtual (la protección contra un disco roto es la de los discos de Windows)')
            else
              LAYOUT=$(mf '%s disco(s), sem espelho: se um disco morrer, perde o histórico' '%s disk(s), no mirror: if a disk dies, the history is lost' '%s disco(s), sin espejo: si un disco muere, se pierde el historial' "$NDEV"); MARK=$I_WARN
            fi ;;
        esac
        if [ "$MISSING" -gt 0 ]; then
          echo "$I_BAD $(m 'Espelho DEGRADADO: falta um disco. Os backups continuam, mas sem proteção.' 'Mirror DEGRADED: a disk is missing. Backups keep going, but unprotected.' 'Espejo DEGRADADO: falta un disco. Los backups siguen, pero sin protección.')"
          echo "$IND $(m 'Coloque um disco novo e rode: sudo backeddy replace-disk /dev/NOVO' 'Put in a new disk and run: sudo backeddy replace-disk /dev/NEW' 'Pon un disco nuevo y ejecuta: sudo backeddy replace-disk /dev/NUEVO')"
        elif [ "$ERRS" -gt 0 ]; then
          echo "$I_WARN $LAYOUT · $(mf 'um disco registrou erros de leitura/gravação (veja: btrfs device stats %s)' 'a disk logged read/write errors (see: btrfs device stats %s)' 'un disco registró errores de lectura/escritura (ver: btrfs device stats %s)' "$DATA")"
        else
          echo "$MARK $LAYOUT"
        fi
      else
        echo "$I_BAD $(m 'Discos de backup NÃO montados: backups parados (veja: journalctl -t backeddy)' 'Backup disks NOT mounted: backups stopped (see: journalctl -t backeddy)' 'Discos de backup NO montados: backups detenidos (ver: journalctl -t backeddy)')"
      fi
    fi
    if [ "$(systemctl is-active backeddy-mount 2>/dev/null)" = activating ]; then
      echo "$I_WAIT $(m 'Montando os discos de backup (até ~40 s se algum disco estiver faltando)…' 'Mounting the backup disks (up to ~40 s if a disk is missing)…' 'Montando los discos de backup (hasta ~40 s si falta algún disco)…')"
    fi
    if [ ! -f "$ETC/disks.conf" ] || mountpoint -q "$DATA"; then
      echo
      if [ "$(findmnt -no FSTYPE "$DATA" 2>/dev/null)" = btrfs ]; then
        read -r USED FREE < <(btrfs filesystem usage -b "$DATA" 2>/dev/null | awk '
          /^Data,/ { if (match($0, /Used:[0-9]+/)) u += substr($0, RSTART + 5, RLENGTH - 5) }
          /Free \(estimated\):/ { f = $3 }
          END { print u + 0, f + 0 }')
        echo "$I_DISK $(mf 'Espaço útil: %s usados · %s livres' 'Usable space: %s used · %s free' 'Espacio útil: %s usados · %s libres' "$(human "$USED")" "$(human "$FREE")")"
      else
        df -h "$DATA" | awk -v i="$I_DISK" -v f="$(m '%s Disco: %s usados de %s (%s livres, %s)' '%s Disk: %s used of %s (%s free, %s)' '%s Disco: %s usados de %s (%s libres, %s)')" 'NR==2{printf f "\n",i,$3,$2,$4,$5}'
      fi
      TM=$(du -sh "$DATA/timemachine" 2>/dev/null | cut -f1 || true)
      KP=$(du -sh "$DATA/kopia" 2>/dev/null | cut -f1 || true)
      TML=""; TIGHT=0
      if [ -f "$SPACE" ]; then
        TML=$(awk -F= '$1=="TM_LIMIT"{print $2}' "$SPACE"); TIGHT=$(awk -F= '$1=="TIGHT"{print $2}' "$SPACE")
      fi
      echo "$IND   Time Machine (Macs): ${TM:-0}${TML:+ · $(m 'pode crescer até' 'can grow to' 'puede crecer hasta') $(human "$TML")}"
      echo "$IND   $(mf 'PCs (Kopia): %s · usam o que precisarem' 'PCs (Kopia): %s · use what they need' 'PC (Kopia): %s · usan lo que necesiten' "${KP:-0}")"
      if [ "$TIGHT" = 1 ]; then
        echo "$I_WARN $(m 'Espaço apertado: o Time Machine está apagando os backups mais antigos para caber.' 'Tight on space: Time Machine is deleting the oldest backups to fit.' 'Espacio justo: Time Machine está borrando los backups más antiguos para caber.')"
        echo "$IND $(m 'Para guardar mais histórico, coloque um disco maior (sudo backeddy add-disk /dev/NOVO).' 'To keep more history, add a bigger disk (sudo backeddy add-disk /dev/NEW).' 'Para guardar más historial, pon un disco mayor (sudo backeddy add-disk /dev/NUEVO).')"
      fi
    fi
    echo
    for d in $(lsblk -dno NAME,TYPE | awk '$2=="disk"{print $1}'); do
      H=$(smartctl -H "/dev/$d" 2>/dev/null | awk -F: '/overall-health|SMART Health Status/{gsub(/^ +/,"",$2);print $2}')
      case "$H" in PASSED|OK) echo "$I_OK /dev/$d $(m 'saudável' 'healthy' 'sano')" ;; "") echo "$I_OFF /dev/$d $(m 'sem SMART (normal em máquina virtual)' 'no SMART (normal in a virtual machine)' 'sin SMART (normal en máquina virtual)')" ;; *) echo "$I_BAD /dev/$d: $H — $(m 'troque este disco!' 'replace this disk!' '¡cambia este disco!')" ;; esac
    done
    echo
    [ -f "$KCONF/fingerprint" ] && echo "$I_KEY $(m 'Impressão digital do certificado (PCs)' 'Certificate fingerprint (PCs)' 'Huella del certificado (PC)'): $(cat "$KCONF/fingerprint")"
    ;;
  add-pc)
    PC="${2:-}"; [ -n "$PC" ] || { echo "Use: sudo backeddy add-pc $(m 'NOME-DO-PC' 'PC-NAME' 'NOMBRE-DEL-PC') [--json]"; exit 1; }
    PC=$(echo "$PC" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9-' '-' | sed 's/^-//;s/-$//')
    [ -n "$PC" ] || exit 1
    PW=$(openssl rand -base64 18 | tr -d '/+=' | cut -c1-16)
    kenv
    # parear de novo o mesmo PC só troca a senha
    if kopia server user list 2>/dev/null | grep -qx "backeddy@$PC"; then
      kopia server user set "backeddy@$PC" --user-password="$PW" >/dev/null
    else
      kopia server user add "backeddy@$PC" --user-password="$PW" >/dev/null
    fi
    kopia server refresh --address=https://127.0.0.1:51515 --insecure \
      --server-control-username=server-control --server-control-password="$(cat "$KCONF/control-password")" >/dev/null 2>&1 \
      || systemctl restart backeddy-kopia
    FP=$(cat "$KCONF/fingerprint")
    if [ "${3:-}" = --json ]; then   # para o pareamento do Backeddy for Windows (/api/pair)
      printf '{"pc":"%s","username":"backeddy","hostname":"%s","password":"%s","url":"https://%s.local:51515","fingerprint":"%s","name":"%s"}\n' \
        "$PC" "$PC" "$PW" "$SLUG" "$FP" "$(printf '%s' "$NAME" | sed 's/\\/\\\\/g; s/"/\\"/g')"
      exit 0
    fi
    echo "$I_DONE $(mf 'PC "%s" autorizado.' 'PC "%s" authorized.' 'PC "%s" autorizado.' "$PC")"
    echo
    m 'No PC (teste manual com o Kopia; o Backeddy for Windows faz isso sozinho):' 'On the PC (manual test with Kopia; Backeddy for Windows does this by itself):' 'En el PC (prueba manual con Kopia; Backeddy for Windows lo hace solo):'; echo
    echo "  kopia repository connect server --url=https://$SLUG.local:51515 \\"
    echo "    --server-cert-fingerprint=$FP \\"
    echo "    --override-username=backeddy --override-hostname=$PC"
    echo "  $(m 'Senha' 'Password' 'Contraseña'): $PW"
    echo
    m 'Guarde esta senha: ela não é mostrada de novo.' 'Keep this password: it isn'"'"'t shown again.' 'Guarda esta contraseña: no se muestra de nuevo.'; echo
    ;;
  pcs)
    # PCs pareados, um por linha (usado pelo painel)
    kenv
    kopia server user list 2>/dev/null | sed -n 's/^backeddy@//p' | sort
    ;;
  remove-pc)
    PC="${2:-}"; [ -n "$PC" ] || { echo "Use: sudo backeddy remove-pc $(m 'NOME-DO-PC' 'PC-NAME' 'NOMBRE-DEL-PC')"; exit 1; }
    kenv
    kopia server user delete "backeddy@$PC" >/dev/null 2>&1 || { m 'PC não encontrado.' 'PC not found.' 'PC no encontrado.'; echo; exit 1; }
    kopia server refresh --address=https://127.0.0.1:51515 --insecure \
      --server-control-username=server-control --server-control-password="$(cat "$KCONF/control-password")" >/dev/null 2>&1 \
      || systemctl restart backeddy-kopia
    echo "$I_DONE $(mf 'PC "%s" não tem mais acesso. Os backups dele continuam guardados.' 'PC "%s" no longer has access. Its backups are still kept.' 'El PC "%s" ya no tiene acceso. Sus backups siguen guardados.' "$PC")"
    ;;
  passwd)
    smbpasswd backeddy
    ;;
  replace-disk)
    NEW="${2:-}"; OLD="${3:-}"
    [ -b "$NEW" ] || { echo "Use: sudo backeddy replace-disk /dev/NOVO [/dev/ANTIGO]"; exit 1; }
    mountpoint -q "$DATA" || { echo "Os discos de backup não estão montados."; exit 1; }
    btrfs filesystem show "$DATA" | grep -qw "$NEW" && { echo "$NEW já faz parte dos discos de backup."; exit 1; }
    if [ -z "$OLD" ]; then
      OLD=$(btrfs filesystem show "$DATA" | awk 'tolower($0) ~ /missing/ && $1 == "devid" {print $2; exit}')
      [ -n "$OLD" ] || { echo "Nenhum disco está faltando. Diga qual substituir: sudo backeddy replace-disk $NEW /dev/ANTIGO"; exit 1; }
      DESC="o disco que está faltando"
    else
      DESC="$OLD"
    fi
    lsblk -o NAME,SIZE,MODEL "$NEW"
    echo "⚠️  TUDO em $NEW será apagado. Ele vai substituir $DESC."
    echo "   (o disco novo precisa ser do mesmo tamanho ou maior que o antigo)"
    read -rp "Para confirmar, digite APAGAR: " C
    [ "$C" = "APAGAR" ] || { echo "Cancelado. Nada foi alterado."; exit 1; }
    wipefs -a "$NEW" >/dev/null
    echo "Reconstruindo o espelho. Em discos grandes leva horas: não desligue o servidor."
    btrfs replace start -B -f "$OLD" "$NEW" "$DATA" || {
      echo "✗ A troca falhou. O disco novo precisa ser do mesmo tamanho ou maior que o antigo."; exit 1; }
    DEVID=$(btrfs filesystem show "$DATA" | awk -v d="$NEW" '$1 == "devid" && $NF == d {print $2}')
    [ -n "$DEVID" ] && btrfs filesystem resize "$DEVID:max" "$DATA" >/dev/null
    # o que foi gravado enquanto faltava um disco volta a ter cópia nos dois
    btrfs balance start -dconvert=raid1,soft -mconvert=raid1,soft "$DATA" >/dev/null 2>&1 || true
    echo "$I_DONE Espelho reconstruído. Confira com: sudo backeddy status"
    ;;
  add-disk)
    NEW="${2:-}"
    [ -b "$NEW" ] || { echo "Use: sudo backeddy add-disk /dev/NOVO"; exit 1; }
    mountpoint -q "$DATA" || { echo "Os discos de backup não estão montados."; exit 1; }
    btrfs filesystem show "$DATA" | grep -qw "$NEW" && { echo "$NEW já faz parte dos discos de backup."; exit 1; }
    lsblk -o NAME,SIZE,MODEL "$NEW"
    echo "⚠️  TUDO em $NEW será apagado. Depois disso, cada backup fica gravado em dois discos."
    read -rp "Para confirmar, digite APAGAR: " C
    [ "$C" = "APAGAR" ] || { echo "Cancelado. Nada foi alterado."; exit 1; }
    wipefs -a "$NEW" >/dev/null
    btrfs device add -f "$NEW" "$DATA"
    echo "Copiando os backups para o novo disco. Pode levar horas: não desligue o servidor."
    btrfs balance start -dconvert=raid1,soft -mconvert=raid1,soft "$DATA"
    tm_limit
    echo "$I_DONE Pronto: backups espelhados. Confira com: sudo backeddy status"
    ;;
  mirror)
    mountpoint -q "$DATA" || { echo "Os discos de backup não estão montados."; exit 1; }
    PROF=$(btrfs filesystem df "$DATA" | awk -F'[ ,:]+' '/^Data/{print $2; exit}')
    case "$PROF" in RAID1*) echo "$I_DONE O espelho já está ligado."; exit 0 ;; esac
    NDEV=$(btrfs filesystem show "$DATA" | grep -c '^[[:space:]]*devid' || true)
    [ "$NDEV" -ge 2 ] || { echo "O espelho precisa de 2 discos. Coloque outro e rode: sudo backeddy add-disk /dev/NOVO"; exit 1; }
    # cabe? cada arquivo passa a ocupar o dobro, sem passar do que o menor conjunto aguenta
    read -r USED TOTAL MAXD < <(btrfs filesystem usage -b "$DATA" | awk '
      /^Data,/ { if (match($0, /Used:[0-9]+/)) u = substr($0, RSTART + 5, RLENGTH - 5) }
      /Device size:/ && !t { t = $3 }
      END { print u + 0, t + 0, 0 }')
    MAXD=$(btrfs filesystem show --raw "$DATA" | awk '$1 == "devid" { s = $4; if (s > m) m = s } END { print m + 0 }')
    CAP=$(( TOTAL / 2 )); REST=$(( TOTAL - MAXD )); [ "$REST" -lt "$CAP" ] && CAP=$REST
    if [ $(( USED * 105 / 100 )) -gt "$CAP" ]; then
      echo "Não cabe: os backups ocupam $(human "$USED") e o espelho comporta $(human "$CAP")."
      echo "Coloque um disco maior (sudo backeddy add-disk /dev/NOVO) ou apague backups antigos."
      exit 1
    fi
    echo "Ligando o espelho: os backups ($(human "$USED")) vão ser copiados para um segundo disco."
    echo "Pode levar horas em discos grandes. O servidor continua funcionando; não desligue."
    btrfs balance start -dconvert=raid1,soft -mconvert=raid1,soft "$DATA"
    tm_limit
    echo "$I_DONE Espelho ligado: se um disco morrer, nada se perde. Confira com: sudo backeddy status"
    ;;
  unmirror)
    mountpoint -q "$DATA" || { echo "Os discos de backup não estão montados."; exit 1; }
    PROF=$(btrfs filesystem df "$DATA" | awk -F'[ ,:]+' '/^Data/{print $2; exit}')
    case "$PROF" in RAID1*) ;; *) echo "O espelho já está desligado."; exit 0 ;; esac
    echo "⚠️  Sem espelho, os backups ganham espaço, mas se um disco morrer você perde o histórico de backups."
    echo "   (Os arquivos nos Macs e PCs continuam; o servidor recomeçaria do zero.)"
    read -rp "Para confirmar, digite SEM ESPELHO: " C
    [ "$C" = "SEM ESPELHO" ] || { echo "Cancelado. Nada foi alterado."; exit 1; }
    btrfs balance start -dconvert=single,soft "$DATA"
    tm_limit
    echo "$I_DONE Espelho desligado. Para ligar de novo: sudo backeddy mirror"
    ;;
  issue)
    # Tela do monitor do servidor (antes do login): situação completa + como conectar.
    # \4 é trocado pelo agetty pelo IP atual, então o endereço nunca fica velho.
    ST=$(TERM=linux BACKEDDY_PLAIN=1 "$0" status 2>/dev/null | tail -n +3 || true)
    NOMIR=$(m 'sem espelho' 'no mirror' 'sin espejo')
    if printf '%s' "$ST" | grep -qF "[$B]"; then
      HEAD=$'\e[1;31m'"$NAME — $(m 'com problema (veja abaixo)' 'has a problem (see below)' 'con problemas (ver abajo)')"$'\e[0m'
    elif printf '%s' "$ST" | grep -vF "$NOMIR" | grep -qF -e "[$W]" -e '[ .... ]'; then
      HEAD=$'\e[1;33m'"$NAME — $(m 'atenção (veja abaixo)' 'attention (see below)' 'atención (ver abajo)')"$'\e[0m'
    else
      HEAD=$'\e[1;32m'"$NAME — $(m 'servidor funcionando' 'server running' 'servidor funcionando')"$'\e[0m'
    fi
    LINE=$'\e[36m'"────────────────────────────────────────────────────────────────────────"$'\e[0m'
    NEW=$(mktemp)
    {
      echo
      echo "  $LINE"
      echo "    $HEAD"
      echo
      if [ "$UI" = en ]; then
        echo "    Mac:      Backeddy for Mac app, or System Settings › General › Time Machine › \"$NAME\""
        echo "              user: backeddy · password: the one set during setup"
        echo "    Windows:  Backeddy for Windows app (coming soon). Server address for the app:"
        echo "              https://$SLUG.local:51515  (or https://\\4:51515) - doesn't open in a browser"
        echo "    Panel:    http://$SLUG.local   (or http://\\4) - status, alerts and quiet hours"
        echo "    Access:   ssh admin@$SLUG.local   (or admin@\\4)"
      elif [ "$UI" = es ]; then
        echo "    Mac:      app Backeddy for Mac, o Ajustes del Sistema › General › Time Machine › \"$NAME\""
        echo "              usuario: backeddy · contraseña: la definida en la instalación"
        echo "    Windows:  app Backeddy for Windows (próximamente). Dirección del servidor para la app:"
        echo "              https://$SLUG.local:51515  (o https://\\4:51515) - no se abre en el navegador"
        echo "    Panel:    http://$SLUG.local   (o http://\\4) - estado, alertas y silencio de noche"
        echo "    Acceso:   ssh admin@$SLUG.local   (o admin@\\4)"
      else
        echo "    Mac:      app Backeddy for Mac, ou Ajustes do Sistema › Geral › Time Machine › \"$NAME\""
        echo "              usuário: backeddy · senha: a definida na instalação"
        echo "    Windows:  app Backeddy for Windows (em breve). Endereço do servidor para o app:"
        echo "              https://$SLUG.local:51515  (ou https://\\4:51515) - não abre no navegador"
        echo "    Painel:   http://$SLUG.local   (ou http://\\4) - situação, alertas e silêncio à noite"
        echo "    Acesso:   ssh admin@$SLUG.local   (ou admin@\\4)"
      fi
      echo "  $LINE"
      printf '%s\n' "$ST" | sed 's/^/    /'
      echo "  $LINE"
      echo "    Backeddy Server $VERSION · $(m 'situação a qualquer momento: sudo backeddy status' 'status at any time: sudo backeddy status' 'estado en cualquier momento: sudo backeddy status')"
      echo
    } > "$NEW"
    if ! cmp -s "$NEW" /etc/issue; then
      install -m 0644 "$NEW" /etc/issue
      agetty --reload >/dev/null 2>&1 || true
    fi
    rm -f "$NEW"
    ;;
  space)
    tm_limit
    ;;
  check)
    # Uma linha por alerta: ID|texto. Usado pelo vigia (backeddy-agent) a cada minuto.
    [ -n "$(net_dev)" ] || echo "no-net|$(m 'Servidor sem rede: os Macs e PCs não alcançam o servidor' 'Server has no network: the Macs and PCs can'"'"'t reach it' 'Servidor sin red: los Mac y PC no llegan a él')"
    if [ -n "$BAT" ] && on_battery; then
      P=$(bat_pct)
      echo "power|$(mf 'Sem energia na tomada: o servidor está na bateria (%s%%)' 'No wall power: the server is on battery (%s%%)' 'Sin corriente: el servidor está con batería (%s%%)' "$P")"
      # desliga com segurança antes de a bateria acabar (desligar de repente pode estragar os backups)
      if [ "$P" != "?" ] && [ "$P" -le 10 ]; then
        logger -t backeddy "bateria em ${P}% sem energia na tomada: desligando com segurança"
        systemctl poweroff >/dev/null 2>&1 || true
      fi
    fi
    for u in smbd:"$(m 'Time Machine (Samba) parado' 'Time Machine (Samba) stopped' 'Time Machine (Samba) detenido')" backeddy-kopia:"$(m 'Servidor dos PCs (Kopia) parado' 'PC server (Kopia) stopped' 'Servidor de los PC (Kopia) detenido')" avahi-daemon:"$(m 'Anúncio na rede (Avahi) parado' 'Network announcement (Avahi) stopped' 'Anuncio en la red (Avahi) detenido')"; do
      st=$(systemctl is-active "${u%%:*}" 2>/dev/null || true)
      [ "$st" = active ] || [ "$st" = activating ] || echo "svc-${u%%:*}|${u#*:}"
    done
    if [ -f "$ETC/disks.conf" ]; then
      if ! mountpoint -q "$DATA"; then
        [ "$(systemctl is-active backeddy-mount 2>/dev/null)" = activating ] || echo "not-mounted|$(m 'Discos de backup não montados: backups parados' 'Backup disks not mounted: backups stopped' 'Discos de backup no montados: backups detenidos')"
      else
        SHOW=$(btrfs filesystem show "$DATA" 2>/dev/null)
        echo "$SHOW" | grep -qi missing && echo "degraded|$(m 'Falta um disco do espelho: troque o disco (sudo backeddy replace-disk)' 'A mirror disk is missing: replace the disk (sudo backeddy replace-disk)' 'Falta un disco del espejo: cambia el disco (sudo backeddy replace-disk)')"
        [ "$(btrfs device stats "$DATA" 2>/dev/null | awk '$2 != 0 {n++} END {print n+0}')" -gt 0 ] \
          && echo "disk-errors|$(m 'Um disco de backup registrou erros de leitura ou gravação' 'A backup disk logged read or write errors' 'Un disco de backup registró errores de lectura o escritura')"
        PCT=$(df -P "$DATA" | awk 'NR==2 {gsub("%","",$5); print $5}')
        [ "${PCT:-0}" -ge 95 ] && echo "space-full|$(mf 'Discos de backup %s%% cheios' 'Backup disks %s%% full' 'Discos de backup al %s%%' "$PCT")"
        [ -f "$SPACE" ] && [ "$(awk -F= '$1=="TIGHT"{print $2}' "$SPACE")" = 1 ] \
          && echo "space-tight|$(m 'Espaço apertado: o Time Machine está apagando backups antigos' 'Tight on space: Time Machine is deleting old backups' 'Espacio justo: Time Machine está borrando backups antiguos')"
        # Mac sem backup novo há 7 dias (cada Mac tem a sua pasta .sparsebundle)
        for b in "$DATA"/timemachine/*.sparsebundle; do
          [ -d "$b" ] || continue
          if [ -z "$(find "$b" -maxdepth 2 -newermt '7 days ago' -print -quit 2>/dev/null)" ]; then
            n=$(basename "$b" .sparsebundle); echo "stale-$n|$(mf 'O Mac "%s" está sem backup há mais de 7 dias' 'The Mac "%s" has had no backup for more than 7 days' 'El Mac "%s" lleva más de 7 días sin backup' "$n")"
          fi
        done
      fi
    fi
    for d in $(lsblk -dno NAME,TYPE | awk '$2=="disk"{print $1}'); do
      H=$(smartctl -H "/dev/$d" 2>/dev/null | awk -F: '/overall-health|SMART Health Status/{gsub(/^ +/,"",$2);print $2}')
      case "$H" in PASSED|OK|"") ;; *) echo "smart-$d|$(mf 'O disco /dev/%s está falhando: troque este disco' 'Disk /dev/%s is failing: replace this disk' 'El disco /dev/%s está fallando: cambia este disco' "$d")" ;; esac
    done
    ;;
  alerts)
    ACKS=/var/lib/backeddy/acks; NOW=$(date +%s); N=0
    while IFS='|' read -r id txt; do
      [ -n "$id" ] || continue
      until=$(awk -v i="$id" '$1==i {print $2}' "$ACKS" 2>/dev/null | tail -1)
      if [ -n "$until" ] && [ "$until" -gt "$NOW" ]; then
        echo "$I_OFF $txt ($(m 'reconhecido até' 'acknowledged until' 'reconocido hasta') $(date -d "@$until" '+%d/%m %H:%M'))"
      else
        echo "$I_BAD $txt"; N=$((N + 1))
      fi
    done < <("$0" check)
    [ "$N" -gt 0 ] && echo && m 'Para parar o bipe: sudo backeddy ack  (ou ack 3 / ack 7 para lembrar em 3 ou 7 dias)' 'To stop the beeping: sudo backeddy ack  (or ack 3 / ack 7 to be reminded in 3 or 7 days)' 'Para detener el pitido: sudo backeddy ack  (o ack 3 / ack 7 para recordar en 3 o 7 días)' && echo
    [ "$N" -eq 0 ] && echo "$I_OK $(m 'Nenhum alerta pendente.' 'No pending alerts.' 'Ninguna alerta pendiente.')"
    ;;
  ack)
    DAYS="${2:-1}"; case "$DAYS" in ''|*[!0-9]*) echo "Use: sudo backeddy ack [DIAS]"; exit 1 ;; esac
    ACKS=/var/lib/backeddy/acks; install -d -m 0755 /var/lib/backeddy
    UNTIL=$(( $(date +%s) + DAYS * 86400 )); N=0
    while IFS='|' read -r id _; do
      [ -n "$id" ] || continue
      { grep -v "^$id " "$ACKS" 2>/dev/null || true; echo "$id $UNTIL"; } > "$ACKS.new" && mv "$ACKS.new" "$ACKS"
      N=$((N + 1))
    done < <("$0" check)
    echo "$I_DONE $(mf '%s alerta(s) reconhecido(s). Se o problema continuar, o servidor lembra em %s dia(s).' '%s alert(s) acknowledged. If the problem persists, the server reminds you in %s day(s).' '%s alerta(s) reconocida(s). Si el problema sigue, el servidor avisa en %s día(s).' "$N" "$DAYS")"
    ;;
  quiet)
    CONF=$ETC/alerts.conf
    case "${2:-}" in
      off) printf 'QUIET_START=\nQUIET_END=\n' > "$CONF"; m 'Silêncio à noite desligado: o bipe toca a qualquer hora.' 'Quiet hours off: the beep sounds at any time.' 'Silencio de noche desactivado: el pitido suena a cualquier hora.'; echo ;;
      [0-9]|1[0-9]|2[0-3])
        E="${3:-8}"
        printf 'QUIET_START=%s\nQUIET_END=%s\n' "$2" "$E" > "$CONF"; mf 'Sem bipe das %sh às %sh.\n' 'No beeping from %s:00 to %s:00.\n' 'Sin pitidos de %s h a %s h.\n' "$2" "$E" ;;
      *) echo "Use: sudo backeddy quiet 22 8   (ou: sudo backeddy quiet off)"; exit 1 ;;
    esac
    ;;
  wifi)
    IF=$(wifi_if)
    [ -n "$IF" ] || { m 'Este computador não tem placa de Wi-Fi que funcione. Use cabo de rede.' 'This computer has no working Wi-Fi card. Use a network cable.' 'Este ordenador no tiene una tarjeta Wi-Fi que funcione. Usa cable de red.'; echo; exit 1; }
    systemctl start iwd >/dev/null 2>&1 || true
    ip link set "$IF" up >/dev/null 2>&1 || true
    CUR=$(net_dev)
    [ -n "$CUR" ] && [ ! -d "/sys/class/net/$CUR/wireless" ] && mf 'Aviso: este servidor está no cabo (%s). O Wi-Fi fica de reserva, se o cabo sair.\n' 'Note: this server is on a cable (%s). Wi-Fi stays as a backup, in case the cable comes out.\n' 'Aviso: este servidor está por cable (%s). El Wi-Fi queda de reserva, si el cable se suelta.\n' "$CUR"
    m 'Procurando redes Wi-Fi…' 'Looking for Wi-Fi networks…' 'Buscando redes Wi-Fi…'; echo
    LIST=""
    for _ in 1 2 3 4; do LIST=$(wifi_scan "$IF" | head -15); [ -n "$LIST" ] && break; sleep 2; done
    mapfile -t NETS <<< "$LIST"
    echo
    i=0
    for n in "${NETS[@]}"; do
      [ -n "$n" ] || continue
      i=$((i + 1)); IFS=$'\t' read -r p e ss <<< "$n"
      printf "  %2d) %s  ($(m 'sinal' 'signal' 'señal') %s%%, %s)\n" "$i" "$ss" "$p" "$([ "$e" = 1 ] && m 'com senha' 'password' 'con contraseña' || m 'aberta' 'open' 'abierta')"
    done
    [ "$i" -eq 0 ] && echo "  $(m 'Nenhuma rede encontrada.' 'No networks found.' 'No se encontró ninguna red.')"
    echo "   0) $(m 'Digitar o nome de outra rede' 'Type the name of another network' 'Escribir el nombre de otra red')"
    echo
    read -rp "$(m 'Número da rede: ' 'Network number: ' 'Número de la red: ')" N
    SEC=1
    if [ "$N" = 0 ]; then
      read -rp "$(m 'Nome da rede (maiúsculas contam): ' 'Network name (capitals matter): ' 'Nombre de la red (las mayúsculas cuentan): ')" SSID
    elif [[ "$N" =~ ^[0-9]+$ ]] && [ "$N" -ge 1 ] && [ "$N" -le "$i" ]; then
      IFS=$'\t' read -r _ SEC SSID <<< "${NETS[$((N - 1))]}"
    else
      m 'Número inválido.' 'Invalid number.' 'Número no válido.'; echo; exit 1
    fi
    [ -n "$SSID" ] || exit 1
    PW=""
    if [ "$SEC" = 1 ]; then read -rsp "$(mf 'Senha do Wi-Fi "%s": ' 'Wi-Fi password for "%s": ' 'Contraseña del Wi-Fi "%s": ' "$SSID")" PW; echo; fi
    mf 'Conectando em "%s"…\n' 'Connecting to "%s"…\n' 'Conectando a "%s"…\n' "$SSID"
    if [ -n "$PW" ]; then OUT=$(iwctl --passphrase "$PW" station "$IF" connect "$SSID" 2>&1) && R=0 || R=$?
    else OUT=$(iwctl station "$IF" connect "$SSID" 2>&1) && R=0 || R=$?; fi
    if [ "$R" != 0 ]; then
      iwctl known-networks "$SSID" forget >/dev/null 2>&1 || true
      echo "$I_BAD $(m 'Não conectou: senha errada ou rede fora de alcance.' 'Didn'"'"'t connect: wrong password or network out of range.' 'No se conectó: contraseña incorrecta o red fuera de alcance.') ($OUT)"; exit 1
    fi
    for _ in $(seq 1 30); do ip -4 addr show dev "$IF" | grep -q 'inet ' && break; sleep 1; done
    if ip -4 addr show dev "$IF" | grep -q 'inet '; then
      echo "$I_DONE $(mf 'Conectado em "%s": %s' 'Connected to "%s": %s' 'Conectado a "%s": %s' "$SSID" "$(ip -4 -o addr show dev "$IF" | awk '{print $4}' | cut -d/ -f1)")"
      echo "   $(m 'O servidor reconecta sozinho nesta rede depois de reiniciar ou se ela cair.' 'The server reconnects to this network by itself after a restart or if it drops.' 'El servidor se reconecta solo a esta red al reiniciar o si se cae.')"
      save_wifi_cfg
      "$0" issue >/dev/null 2>&1 || true
    else
      echo "$I_WARN $(m 'Conectou no Wi-Fi, mas o roteador não deu endereço. Tente reiniciar o roteador.' 'Connected to Wi-Fi, but the router gave no address. Try restarting the router.' 'Se conectó al Wi-Fi, pero el router no dio dirección. Prueba a reiniciar el router.')"
      exit 1
    fi
    ;;
  *) sed -n '2,16p' "$0"; exit 1 ;;
esac
