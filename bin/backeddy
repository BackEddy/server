#!/bin/bash
# backeddy — comandos do Backeddy Server
#   backeddy status            situação do servidor
#   backeddy add-pc NOME       autoriza um PC Windows a fazer backup (Kopia)
#   backeddy passwd            troca a senha usada pelos Macs
#   backeddy replace-disk NOVO [ANTIGO]   troca um disco do espelho (morto ou com defeito)
#   backeddy add-disk NOVO     acrescenta um disco e passa a espelhar os backups
#   backeddy mirror            liga o espelho (cada arquivo em 2 discos), se houver espaço
#   backeddy unmirror          desliga o espelho: mais espaço, SEM proteção
#   backeddy space             recalcula a divisão do espaço entre Macs e PCs (automático, a cada hora)
#   backeddy alerts            alertas ativos (o servidor bipa até alguém reconhecer)
#   backeddy ack [DIAS]        reconhece os alertas: para de bipar e lembra de novo em DIAS (padrão 1)
#   backeddy quiet INÍCIO FIM  silêncio à noite (ex.: 22 8) · backeddy quiet off
#   backeddy issue             atualiza a tela do monitor do servidor (situação + como conectar)
set -euo pipefail
ETC=/etc/backeddy; DATA=/srv/backeddy; KCONF=$ETC/kopia
[ "$(id -u)" = 0 ] || { echo "Use: sudo backeddy $*"; exit 1; }
. "$ETC/server.conf"
kenv() {
  export KOPIA_CONFIG_PATH="$KCONF/repository.config" KOPIA_CACHE_DIRECTORY=/var/cache/backeddy-kopia KOPIA_LOG_DIR=/var/log/backeddy-kopia
  export KOPIA_PASSWORD; KOPIA_PASSWORD=$(cat "$KCONF/repo-password")
}
svc() {
  case "$(systemctl is-active "$1" 2>/dev/null)" in
    active) echo "$I_OK $2" ;;
    activating) echo "$I_WAIT $2 (aguardando os discos de backup…)" ;;
    *) echo "$I_BAD $2 (parado: sudo systemctl status $1)" ;;
  esac
}
# No monitor do próprio servidor (console) não existem emojis: usa cores e texto.
if [ "${TERM:-}" = linux ] || [ -n "${BACKEDDY_PLAIN:-}" ]; then
  I_OK=$'\e[1;32m[  OK  ]\e[0m'; I_WARN=$'\e[1;33m[AVISO ]\e[0m'; I_BAD=$'\e[1;31m[ ERRO ]\e[0m'
  I_WAIT=$'\e[1;36m[ .... ]\e[0m'; I_OFF=$'\e[2m[  --  ]\e[0m'; I_HEAD='  '; I_DISK='        '; I_KEY='        '; I_DONE=$'\e[1;32m[  OK  ]\e[0m'
  IND='        '
else
  I_OK='🟢'; I_WARN='🟡'; I_BAD='🔴'; I_WAIT='⏳'; I_OFF='⚪'; I_HEAD='🌀'; I_DISK='💾'; I_KEY='🔐'; I_DONE='✅'
  IND='  '
fi
# Divisão automática do espaço: os PCs (Kopia) usam o que precisam; o Time Machine fica com o
# resto, menos uma folga (10% do espaço útil, ou 20 GB se couber), e nunca menos de 20%.
# Roda a cada hora (backeddy-space.timer) e depois de mudar discos ou espelho.
SPACE=/var/lib/backeddy/space
tm_limit() {
  local used free usable kp reserve floor limit gb tight=0 cur twenty
  mountpoint -q "$DATA" || return 0
  if [ "$(findmnt -no FSTYPE "$DATA")" = btrfs ]; then
    read -r used free < <(btrfs filesystem usage -b "$DATA" 2>/dev/null | awk '
      /^Data,/ { if (match($0, /Used:[0-9]+/)) u += substr($0, RSTART + 5, RLENGTH - 5) }
      /Free \(estimated\):/ { f = $3 }
      END { print u + 0, f + 0 }')
    usable=$((used + free))
  else
    usable=$(df -Pk "$DATA" | awk 'NR==2 {print $2 * 1024}')
  fi
  kp=$(du -sb "$DATA/kopia" 2>/dev/null | cut -f1); kp=${kp:-0}
  reserve=$(( usable / 10 )); twenty=$(( 20 * 1024 * 1024 * 1024 ))
  [ "$reserve" -lt "$twenty" ] && [ "$twenty" -le $(( usable / 5 )) ] && reserve=$twenty
  floor=$(( usable / 5 ))
  limit=$(( usable - kp - reserve ))
  if [ "$limit" -lt "$floor" ]; then limit=$floor; tight=1; fi
  gb=$(( limit / 1024 / 1024 / 1024 )); [ "$gb" -lt 1 ] && gb=1
  install -d -m 0755 "$(dirname "$SPACE")"
  printf 'USABLE=%s\nKOPIA=%s\nTM_LIMIT=%s\nTIGHT=%s\n' "$usable" "$kp" "$((gb * 1024 * 1024 * 1024))" "$tight" > "$SPACE"
  cur=$(awk -F'= *' '/fruit:time machine max size/ {print $2; exit}' /etc/samba/smb.conf)
  if [ "$cur" != "${gb}G" ]; then
    sed -i "s|^\([[:space:]]*fruit:time machine max size = \).*|\1${gb}G|" /etc/samba/smb.conf
    systemctl reload smbd >/dev/null 2>&1 || systemctl restart smbd >/dev/null 2>&1 || true
  fi
  [ "${1:-}" = quiet ] || echo "   Limite do Time Machine agora: ${gb} GB (PCs usam $(human "$kp"))"
}
human() { numfmt --to=iec --suffix=B "$1" 2>/dev/null || echo "$1"; }

case "${1:-status}" in
  status)
    echo "$I_HEAD $NAME  ·  $SLUG.local  ·  $(hostname -I | awk '{print $1}')  ·  Backeddy Server $VERSION"
    echo
    svc smbd "Time Machine (Samba)"
    svc avahi-daemon "Anúncio na rede (Avahi)"
    svc backeddy-kopia "Kopia Server (PCs)"
    if [ -s /run/backeddy/alerts ]; then
      while IFS='|' read -r _ txt; do echo "$I_BAD ALERTA: $txt"; done < /run/backeddy/alerts
      echo "$IND O servidor está bipando. Para parar: sudo backeddy ack (ou aperte uma tecla no servidor)"
    fi
    if [ -f "$ETC/disks.conf" ]; then
      if mountpoint -q "$DATA"; then
        SHOW=$(btrfs filesystem show "$DATA" 2>/dev/null)
        PROF=$(btrfs filesystem df "$DATA" 2>/dev/null | awk -F'[ ,:]+' '/^Data/{print $2; exit}')
        NDEV=$(echo "$SHOW" | grep -c '^[[:space:]]*devid' || true)
        MISSING=$(echo "$SHOW" | grep -ci 'missing' || true)
        ERRS=$(btrfs device stats "$DATA" 2>/dev/null | awk '$2 != 0 {n++} END {print n+0}')
        MARK=$I_OK
        case "$PROF" in
          RAID1*) LAYOUT="Espelho de $NDEV discos" ;;
          *) LAYOUT="$NDEV disco(s), sem espelho: se um disco morrer, perde o histórico"; MARK=$I_WARN ;;
        esac
        if [ "$MISSING" -gt 0 ]; then
          echo "$I_BAD Espelho DEGRADADO: falta um disco. Os backups continuam, mas sem proteção."
          echo "$IND Coloque um disco novo e rode: sudo backeddy replace-disk /dev/NOVO"
        elif [ "$ERRS" -gt 0 ]; then
          echo "$I_WARN $LAYOUT · um disco registrou erros de leitura/gravação (veja: btrfs device stats $DATA)"
        else
          echo "$MARK $LAYOUT"
        fi
      else
        echo "$I_BAD Discos de backup NÃO montados: backups parados (veja: journalctl -t backeddy)"
      fi
    fi
    if [ "$(systemctl is-active backeddy-mount 2>/dev/null)" = activating ]; then
      echo "$I_WAIT Montando os discos de backup (até ~40 s se algum disco estiver faltando)…"
    fi
    if [ ! -f "$ETC/disks.conf" ] || mountpoint -q "$DATA"; then
      echo
      if [ "$(findmnt -no FSTYPE "$DATA" 2>/dev/null)" = btrfs ]; then
        read -r USED FREE < <(btrfs filesystem usage -b "$DATA" 2>/dev/null | awk '
          /^Data,/ { if (match($0, /Used:[0-9]+/)) u += substr($0, RSTART + 5, RLENGTH - 5) }
          /Free \(estimated\):/ { f = $3 }
          END { print u + 0, f + 0 }')
        echo "$I_DISK Espaço útil: $(human "$USED") usados · $(human "$FREE") livres"
      else
        df -h "$DATA" | awk -v i="$I_DISK" 'NR==2{printf "%s Disco: %s usados de %s (%s livres, %s)\n",i,$3,$2,$4,$5}'
      fi
      TM=$(du -sh "$DATA/timemachine" 2>/dev/null | cut -f1 || true)
      KP=$(du -sh "$DATA/kopia" 2>/dev/null | cut -f1 || true)
      TML=""; TIGHT=0
      if [ -f "$SPACE" ]; then
        TML=$(awk -F= '$1=="TM_LIMIT"{print $2}' "$SPACE"); TIGHT=$(awk -F= '$1=="TIGHT"{print $2}' "$SPACE")
      fi
      echo "$IND   Time Machine (Macs): ${TM:-0}${TML:+ · pode crescer até $(human "$TML")}"
      echo "$IND   PCs (Kopia): ${KP:-0} · usam o que precisarem"
      if [ "$TIGHT" = 1 ]; then
        echo "$I_WARN Espaço apertado: o Time Machine está apagando os backups mais antigos para caber."
        echo "$IND Para guardar mais histórico, coloque um disco maior (sudo backeddy add-disk /dev/NOVO)."
      fi
    fi
    echo
    for d in $(lsblk -dno NAME,TYPE | awk '$2=="disk"{print $1}'); do
      H=$(smartctl -H "/dev/$d" 2>/dev/null | awk -F: '/overall-health|SMART Health Status/{gsub(/^ +/,"",$2);print $2}')
      case "$H" in PASSED|OK) echo "$I_OK /dev/$d saudável" ;; "") echo "$I_OFF /dev/$d sem SMART (normal em máquina virtual)" ;; *) echo "$I_BAD /dev/$d: $H — troque este disco!" ;; esac
    done
    echo
    [ -f "$KCONF/fingerprint" ] && echo "$I_KEY Impressão digital do certificado (PCs): $(cat "$KCONF/fingerprint")"
    ;;
  add-pc)
    PC="${2:-}"; [ -n "$PC" ] || { echo "Use: sudo backeddy add-pc NOME-DO-PC"; exit 1; }
    PC=$(echo "$PC" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9-' '-' | sed 's/^-//;s/-$//')
    PW=$(openssl rand -base64 18 | tr -d '/+=' | cut -c1-16)
    kenv
    kopia server user add "backeddy@$PC" --user-password="$PW" >/dev/null
    kopia server refresh --address=https://127.0.0.1:51515 --insecure \
      --server-control-username=server-control --server-control-password="$(cat "$KCONF/control-password")" >/dev/null 2>&1 \
      || systemctl restart backeddy-kopia
    cat <<MSG
$I_DONE PC "$PC" autorizado.

No PC (teste manual com o Kopia, até o Backeddy for Windows existir):
  kopia repository connect server --url=https://$SLUG.local:51515 \\
    --server-cert-fingerprint=$(cat "$KCONF/fingerprint") \\
    --override-username=backeddy --override-hostname=$PC
  Senha: $PW

Guarde esta senha: ela não é mostrada de novo.
MSG
    ;;
  passwd)
    smbpasswd backeddy
    ;;
  replace-disk)
    NEW="${2:-}"; OLD="${3:-}"
    [ -b "$NEW" ] || { echo "Use: sudo backeddy replace-disk /dev/NOVO [/dev/ANTIGO]"; exit 1; }
    mountpoint -q "$DATA" || { echo "Os discos de backup não estão montados."; exit 1; }
    btrfs filesystem show "$DATA" | grep -qw "$NEW" && { echo "$NEW já faz parte dos discos de backup."; exit 1; }
    if [ -z "$OLD" ]; then
      OLD=$(btrfs filesystem show "$DATA" | awk 'tolower($0) ~ /missing/ && $1 == "devid" {print $2; exit}')
      [ -n "$OLD" ] || { echo "Nenhum disco está faltando. Diga qual substituir: sudo backeddy replace-disk $NEW /dev/ANTIGO"; exit 1; }
      DESC="o disco que está faltando"
    else
      DESC="$OLD"
    fi
    lsblk -o NAME,SIZE,MODEL "$NEW"
    echo "⚠️  TUDO em $NEW será apagado. Ele vai substituir $DESC."
    echo "   (o disco novo precisa ser do mesmo tamanho ou maior que o antigo)"
    read -rp "Para confirmar, digite APAGAR: " C
    [ "$C" = "APAGAR" ] || { echo "Cancelado. Nada foi alterado."; exit 1; }
    wipefs -a "$NEW" >/dev/null
    echo "Reconstruindo o espelho. Em discos grandes leva horas: não desligue o servidor."
    btrfs replace start -B -f "$OLD" "$NEW" "$DATA" || {
      echo "✗ A troca falhou. O disco novo precisa ser do mesmo tamanho ou maior que o antigo."; exit 1; }
    DEVID=$(btrfs filesystem show "$DATA" | awk -v d="$NEW" '$1 == "devid" && $NF == d {print $2}')
    [ -n "$DEVID" ] && btrfs filesystem resize "$DEVID:max" "$DATA" >/dev/null
    # o que foi gravado enquanto faltava um disco volta a ter cópia nos dois
    btrfs balance start -dconvert=raid1,soft -mconvert=raid1,soft "$DATA" >/dev/null 2>&1 || true
    echo "$I_DONE Espelho reconstruído. Confira com: sudo backeddy status"
    ;;
  add-disk)
    NEW="${2:-}"
    [ -b "$NEW" ] || { echo "Use: sudo backeddy add-disk /dev/NOVO"; exit 1; }
    mountpoint -q "$DATA" || { echo "Os discos de backup não estão montados."; exit 1; }
    btrfs filesystem show "$DATA" | grep -qw "$NEW" && { echo "$NEW já faz parte dos discos de backup."; exit 1; }
    lsblk -o NAME,SIZE,MODEL "$NEW"
    echo "⚠️  TUDO em $NEW será apagado. Depois disso, cada backup fica gravado em dois discos."
    read -rp "Para confirmar, digite APAGAR: " C
    [ "$C" = "APAGAR" ] || { echo "Cancelado. Nada foi alterado."; exit 1; }
    wipefs -a "$NEW" >/dev/null
    btrfs device add -f "$NEW" "$DATA"
    echo "Copiando os backups para o novo disco. Pode levar horas: não desligue o servidor."
    btrfs balance start -dconvert=raid1,soft -mconvert=raid1,soft "$DATA"
    tm_limit
    echo "$I_DONE Pronto: backups espelhados. Confira com: sudo backeddy status"
    ;;
  mirror)
    mountpoint -q "$DATA" || { echo "Os discos de backup não estão montados."; exit 1; }
    PROF=$(btrfs filesystem df "$DATA" | awk -F'[ ,:]+' '/^Data/{print $2; exit}')
    case "$PROF" in RAID1*) echo "$I_DONE O espelho já está ligado."; exit 0 ;; esac
    NDEV=$(btrfs filesystem show "$DATA" | grep -c '^[[:space:]]*devid' || true)
    [ "$NDEV" -ge 2 ] || { echo "O espelho precisa de 2 discos. Coloque outro e rode: sudo backeddy add-disk /dev/NOVO"; exit 1; }
    # cabe? cada arquivo passa a ocupar o dobro, sem passar do que o menor conjunto aguenta
    read -r USED TOTAL MAXD < <(btrfs filesystem usage -b "$DATA" | awk '
      /^Data,/ { if (match($0, /Used:[0-9]+/)) u = substr($0, RSTART + 5, RLENGTH - 5) }
      /Device size:/ && !t { t = $3 }
      END { print u + 0, t + 0, 0 }')
    MAXD=$(btrfs filesystem show --raw "$DATA" | awk '$1 == "devid" { s = $4; if (s > m) m = s } END { print m + 0 }')
    CAP=$(( TOTAL / 2 )); REST=$(( TOTAL - MAXD )); [ "$REST" -lt "$CAP" ] && CAP=$REST
    if [ $(( USED * 105 / 100 )) -gt "$CAP" ]; then
      echo "Não cabe: os backups ocupam $(human "$USED") e o espelho comporta $(human "$CAP")."
      echo "Coloque um disco maior (sudo backeddy add-disk /dev/NOVO) ou apague backups antigos."
      exit 1
    fi
    echo "Ligando o espelho: os backups ($(human "$USED")) vão ser copiados para um segundo disco."
    echo "Pode levar horas em discos grandes. O servidor continua funcionando; não desligue."
    btrfs balance start -dconvert=raid1,soft -mconvert=raid1,soft "$DATA"
    tm_limit
    echo "$I_DONE Espelho ligado: se um disco morrer, nada se perde. Confira com: sudo backeddy status"
    ;;
  unmirror)
    mountpoint -q "$DATA" || { echo "Os discos de backup não estão montados."; exit 1; }
    PROF=$(btrfs filesystem df "$DATA" | awk -F'[ ,:]+' '/^Data/{print $2; exit}')
    case "$PROF" in RAID1*) ;; *) echo "O espelho já está desligado."; exit 0 ;; esac
    echo "⚠️  Sem espelho, os backups ganham espaço, mas se um disco morrer você perde o histórico de backups."
    echo "   (Os arquivos nos Macs e PCs continuam; o servidor recomeçaria do zero.)"
    read -rp "Para confirmar, digite SEM ESPELHO: " C
    [ "$C" = "SEM ESPELHO" ] || { echo "Cancelado. Nada foi alterado."; exit 1; }
    btrfs balance start -dconvert=single,soft "$DATA"
    tm_limit
    echo "$I_DONE Espelho desligado. Para ligar de novo: sudo backeddy mirror"
    ;;
  issue)
    # Tela do monitor do servidor (antes do login): situação completa + como conectar.
    # \4 é trocado pelo agetty pelo IP atual, então o endereço nunca fica velho.
    ST=$(TERM=linux BACKEDDY_PLAIN=1 "$0" status 2>/dev/null | tail -n +3 || true)
    if printf '%s' "$ST" | grep -q 'ERRO'; then
      HEAD=$'\e[1;31m'"$NAME — com problema (veja abaixo)"$'\e[0m'
    elif printf '%s' "$ST" | grep -v 'sem espelho' | grep -q 'AVISO\|\.\.\.\.'; then
      HEAD=$'\e[1;33m'"$NAME — atenção (veja abaixo)"$'\e[0m'
    else
      HEAD=$'\e[1;32m'"$NAME — servidor funcionando"$'\e[0m'
    fi
    LINE=$'\e[36m'"────────────────────────────────────────────────────────────────────────"$'\e[0m'
    NEW=$(mktemp)
    {
      echo
      echo "  $LINE"
      echo "    $HEAD"
      echo
      echo "    Mac:      Ajustes do Sistema › Geral › Time Machine › \"$NAME\""
      echo "              usuário: backeddy · senha: a definida na instalação"
      echo "    Windows:  app Backeddy for Windows (em breve). Endereço do servidor para o app:"
      echo "              https://$SLUG.local:51515  (ou https://\\4:51515) - não abre no navegador"
      echo "    Painel:   http://$SLUG.local   (ou http://\\4) - situação, alertas e silêncio à noite"
      echo "    Acesso:   ssh admin@$SLUG.local   (ou admin@\\4)"
      echo "  $LINE"
      printf '%s\n' "$ST" | sed 's/^/    /'
      echo "  $LINE"
      echo "    Backeddy Server $VERSION · situação a qualquer momento: sudo backeddy status"
      echo
    } > "$NEW"
    if ! cmp -s "$NEW" /etc/issue; then
      install -m 0644 "$NEW" /etc/issue
      agetty --reload >/dev/null 2>&1 || true
    fi
    rm -f "$NEW"
    ;;
  space)
    tm_limit
    ;;
  check)
    # Uma linha por alerta: ID|texto. Usado pelo vigia (backeddy-agent) a cada minuto.
    for u in smbd:"Time Machine (Samba) parado" backeddy-kopia:"Servidor dos PCs (Kopia) parado" avahi-daemon:"Anúncio na rede (Avahi) parado"; do
      st=$(systemctl is-active "${u%%:*}" 2>/dev/null || true)
      [ "$st" = active ] || [ "$st" = activating ] || echo "svc-${u%%:*}|${u#*:}"
    done
    if [ -f "$ETC/disks.conf" ]; then
      if ! mountpoint -q "$DATA"; then
        [ "$(systemctl is-active backeddy-mount 2>/dev/null)" = activating ] || echo "not-mounted|Discos de backup não montados: backups parados"
      else
        SHOW=$(btrfs filesystem show "$DATA" 2>/dev/null)
        echo "$SHOW" | grep -qi missing && echo "degraded|Falta um disco do espelho: troque o disco (sudo backeddy replace-disk)"
        [ "$(btrfs device stats "$DATA" 2>/dev/null | awk '$2 != 0 {n++} END {print n+0}')" -gt 0 ] \
          && echo "disk-errors|Um disco de backup registrou erros de leitura ou gravação"
        PCT=$(df -P "$DATA" | awk 'NR==2 {gsub("%","",$5); print $5}')
        [ "${PCT:-0}" -ge 95 ] && echo "space-full|Discos de backup ${PCT}% cheios"
        [ -f "$SPACE" ] && [ "$(awk -F= '$1=="TIGHT"{print $2}' "$SPACE")" = 1 ] \
          && echo "space-tight|Espaço apertado: o Time Machine está apagando backups antigos"
        # Mac sem backup novo há 7 dias (cada Mac tem a sua pasta .sparsebundle)
        for b in "$DATA"/timemachine/*.sparsebundle; do
          [ -d "$b" ] || continue
          if [ -z "$(find "$b" -maxdepth 2 -newermt '7 days ago' -print -quit 2>/dev/null)" ]; then
            n=$(basename "$b" .sparsebundle); echo "stale-$n|O Mac \"$n\" está sem backup há mais de 7 dias"
          fi
        done
      fi
    fi
    for d in $(lsblk -dno NAME,TYPE | awk '$2=="disk"{print $1}'); do
      H=$(smartctl -H "/dev/$d" 2>/dev/null | awk -F: '/overall-health|SMART Health Status/{gsub(/^ +/,"",$2);print $2}')
      case "$H" in PASSED|OK|"") ;; *) echo "smart-$d|O disco /dev/$d está falhando: troque este disco" ;; esac
    done
    ;;
  alerts)
    ACKS=/var/lib/backeddy/acks; NOW=$(date +%s); N=0
    while IFS='|' read -r id txt; do
      [ -n "$id" ] || continue
      until=$(awk -v i="$id" '$1==i {print $2}' "$ACKS" 2>/dev/null | tail -1)
      if [ -n "$until" ] && [ "$until" -gt "$NOW" ]; then
        echo "$I_OFF $txt (reconhecido até $(date -d "@$until" '+%d/%m %H:%M'))"
      else
        echo "$I_BAD $txt"; N=$((N + 1))
      fi
    done < <("$0" check)
    [ "$N" -gt 0 ] && echo && echo "Para parar o bipe: sudo backeddy ack  (ou ack 3 / ack 7 para lembrar em 3 ou 7 dias)"
    [ "$N" -eq 0 ] && echo "$I_OK Nenhum alerta pendente."
    ;;
  ack)
    DAYS="${2:-1}"; case "$DAYS" in ''|*[!0-9]*) echo "Use: sudo backeddy ack [DIAS]"; exit 1 ;; esac
    ACKS=/var/lib/backeddy/acks; install -d -m 0755 /var/lib/backeddy
    UNTIL=$(( $(date +%s) + DAYS * 86400 )); N=0
    while IFS='|' read -r id _; do
      [ -n "$id" ] || continue
      { grep -v "^$id " "$ACKS" 2>/dev/null || true; echo "$id $UNTIL"; } > "$ACKS.new" && mv "$ACKS.new" "$ACKS"
      N=$((N + 1))
    done < <("$0" check)
    echo "$I_DONE $N alerta(s) reconhecido(s). Se o problema continuar, o servidor lembra em $DAYS dia(s)."
    ;;
  quiet)
    CONF=$ETC/alerts.conf
    case "${2:-}" in
      off) printf 'QUIET_START=\nQUIET_END=\n' > "$CONF"; echo "Silêncio à noite desligado: o bipe toca a qualquer hora." ;;
      [0-9]|1[0-9]|2[0-3])
        E="${3:-8}"
        printf 'QUIET_START=%s\nQUIET_END=%s\n' "$2" "$E" > "$CONF"; echo "Sem bipe das ${2}h às ${E}h." ;;
      *) echo "Use: sudo backeddy quiet 22 8   (ou: sudo backeddy quiet off)"; exit 1 ;;
    esac
    ;;
  *) sed -n '2,14p' "$0"; exit 1 ;;
esac
