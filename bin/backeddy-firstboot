#!/bin/bash
# Primeiro boot do Backeddy Server instalado pelo pendrive: configura os discos de backup,
# Samba (Time Machine) e Kopia rodando o install.sh sem perguntas. Depois se desliga.
set -uo pipefail
ENV=/etc/backeddy/firstboot.env
LOG=/var/log/backeddy-firstboot.log
[ -f "$ENV" ] || exit 0
# shellcheck disable=SC1090
. "$ENV"

issue() {
  printf '%s\n' "$@" > /etc/issue
  agetty --reload >/dev/null 2>&1 || true
}

issue "" "  Backeddy Server" "" "  Preparando os discos de backup... (alguns minutos, nao desligue)" ""

NAME=$(printf '%s' "$NAME_B64" | base64 -d)
ARGS=(--yes --name "$NAME" --tm-percent "${TM_PERCENT:-60}")
for d in $DISKS; do
  # espera o disco aparecer (discos USB podem demorar)
  for _ in $(seq 1 30); do [ -b "$d" ] && break; sleep 1; done
  ARGS+=(--disk "$d")
done

if BACKEDDY_PASSWORD=$(printf '%s' "$PASSWORD_B64" | base64 -d) \
   bash /opt/backeddy-server/install.sh "${ARGS[@]}" >"$LOG" 2>&1; then
  rm -f "$ENV"
  systemctl disable backeddy-firstboot.service >/dev/null 2>&1 || true
  # shellcheck disable=SC1091
  . /etc/backeddy/server.conf
  issue "" \
    "  Backeddy Server  -  $NAME" \
    "" \
    "  Pronto! Endereco na rede: $SLUG.local  (\\4)" \
    "" \
    "  Mac:     Ajustes do Sistema > Geral > Time Machine > + > \"$NAME\"" \
    "           usuario: backeddy   senha: a definida na instalacao" \
    "  Windows: Backeddy for Windows (em breve) ou Kopia: https://$SLUG.local:51515" \
    "" \
    "  Administracao: entre como 'admin' e rode:  sudo backeddy status" \
    ""
else
  rm -f "$ENV"   # a senha não fica no disco; para tentar de novo, rode o install.sh na mão
  issue "" "  Backeddy Server: ERRO ao preparar os discos." \
    "  Entre como 'admin' e veja: sudo cat $LOG" ""
  exit 1
fi
