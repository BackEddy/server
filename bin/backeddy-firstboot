#!/bin/bash
# Primeiro boot do Backeddy Server (pendrive ou máquina virtual): configura os discos de backup,
# Samba (Time Machine) e Kopia rodando o install.sh sem perguntas. Depois se desliga.
# Enquanto trabalha, mostra uma tela limpa no monitor do PC (tty1).
set -uo pipefail
ENV=/etc/backeddy/firstboot.env
LOG=/var/log/backeddy-firstboot.log
TTY=/dev/tty1
VMCFG=""
# Máquina virtual: nome e senha vêm no disquinho de configuração (BACKEDDYCFG), criado pelo
# instalador do Windows. Feito o primeiro boot, o arquivo é apagado de lá (tem a senha).
if [ ! -f "$ENV" ] && [ -f /etc/backeddy-vm ]; then
  for _ in $(seq 1 15); do [ -e /dev/disk/by-label/BACKEDDYCFG ] && break; sleep 1; done
  if [ -e /dev/disk/by-label/BACKEDDYCFG ]; then
    VMCFG=/run/backeddy-cfg
    mkdir -p "$VMCFG" /etc/backeddy
    if mount /dev/disk/by-label/BACKEDDYCFG "$VMCFG" && [ -f "$VMCFG/firstboot.env" ]; then
      tr -d '\r' < "$VMCFG/firstboot.env" > "$ENV"   # escrito no Windows: tira o CR do fim das linhas
      chmod 600 "$ENV"
    fi
  fi
fi
[ -f "$ENV" ] || exit 0
# shellcheck disable=SC1090
. "$ENV"

# identidade desta máquina (a imagem é igual para todo mundo)
if ! ls /etc/ssh/ssh_host_*_key >/dev/null 2>&1; then
  ssh-keygen -A >/dev/null 2>&1
  systemctl restart ssh >/dev/null 2>&1 || true
fi

# textos da tela no idioma escolhido no instalador (o env é lido logo abaixo)
tr3() { case "${UI_LANG:-pt}" in en) printf '%s' "$2" ;; es) printf '%s' "$3" ;; *) printf '%s' "$1" ;; esac; }
screen() { # $1 = linha de situação
  { printf '\033[2J\033[H\033[?25l\n'
    printf '  \033[1;36mBackeddy Server\033[0m\n'
    printf '  \033[36m──────────────────────────────────────────────────────────\033[0m\n\n'
    printf '  %s\n\n' "$1"
    printf '  \033[2m%s\033[0m\n' "$(tr3 'Não desligue o computador. Isso acontece só uma vez.' 'Don'"'"'t turn off the computer. This only happens once.' 'No apagues el ordenador. Esto pasa solo una vez.')"
  } > "$TTY" 2>/dev/null || true
}

NAME=$(printf '%s' "${NAME_B64:-}" | base64 -d)
if [ "${RECOVER:-0}" = 1 ]; then
  # reinstalação: nome e divisão do espaço vêm da configuração guardada nos discos de backup
  ARGS=(--yes --recover)
else
  ARGS=(--yes --name "$NAME" --tm-percent "${TM_PERCENT:-60}")
fi
[ "${NO_MIRROR:-0}" = 1 ] && ARGS+=(--no-mirror)
[ -n "${UI_LANG:-}" ] && ARGS+=(--lang "$UI_LANG")
# alarme escolhido no instalador (silêncio à noite; o install.sh mantém este arquivo)
if [ -n "${QUIET_START+x}" ]; then
  mkdir -p /etc/backeddy
  printf 'QUIET_START=%s\nQUIET_END=%s\nBEEP_OK=%s\n' "$QUIET_START" "${QUIET_END:-}" "${BEEP_OK:-1}" > /etc/backeddy/alerts.conf
fi
screen "$(tr3 'Procurando os discos de backup…' 'Looking for the backup disks…' 'Buscando los discos de backup…')"
if [ "${DISKS:-}" = auto ]; then
  # máquina virtual: o disco de backup é o disco vazio (sem partições) que não é o do sistema
  ROOTDISK=$(lsblk -no PKNAME "$(findmnt -no SOURCE /)" | head -1)
  DISKS=""
  for _ in $(seq 1 15); do
    while read -r n t sz; do
      [ "$t" = disk ] && [ "$n" != "$ROOTDISK" ] && [ "$sz" -ge $((8 * 1024 * 1024 * 1024)) ] || continue
      [ -z "$(lsblk -no NAME "/dev/$n" | tail -n +2)" ] || continue
      [ -n "$(blkid -p "/dev/$n" 2>/dev/null)" ] && continue
      DISKS="$DISKS /dev/$n"
    done < <(lsblk -bdno NAME,TYPE,SIZE)
    [ -n "$DISKS" ] && break
    sleep 1
  done
fi
# usuário de administração com a mesma senha (no pendrive, o instalador já criou)
if ! id admin >/dev/null 2>&1; then
  useradd -m -s /bin/bash -G sudo admin
  printf 'admin:%s\n' "$(printf '%s' "$PASSWORD_B64" | base64 -d)" | chpasswd
fi
for d in $DISKS; do
  # espera o disco aparecer (discos USB podem demorar)
  for _ in $(seq 1 30); do [ -b "$d" ] && break; sleep 1; done
  ARGS+=(--disk "$d")
done

BACKEDDY_PASSWORD=$(printf '%s' "$PASSWORD_B64" | base64 -d) \
  bash /opt/backeddy-server/install.sh "${ARGS[@]}" >"$LOG" 2>&1 &
PID=$!
START=$(date +%s)
SPIN='|/-\'
i=0
while kill -0 "$PID" 2>/dev/null; do
  EL=$(( $(date +%s) - START ))
  screen "${SPIN:i++%4:1}  $(tr3 'Preparando os discos de backup e os serviços…' 'Preparing the backup disks and services…' 'Preparando los discos de backup y los servicios…')   $((EL / 60)) min $((EL % 60)) s"
  sleep 1
done
wait "$PID"
RC=$?

rm -f "$ENV"   # a senha não fica no disco
if [ -n "$VMCFG" ] && mountpoint -q "$VMCFG"; then
  rm -f "$VMCFG/firstboot.env"
  umount "$VMCFG" || true
fi
printf '\033[2J\033[H\033[?25h' > "$TTY" 2>/dev/null || true
if [ "$RC" = 0 ]; then
  systemctl disable backeddy-firstboot.service >/dev/null 2>&1 || true
  /usr/local/bin/backeddy issue >/dev/null 2>&1 || true
else
  # para tentar de novo, rode o install.sh na mão
  printf '%s\n' "" "  Backeddy Server: ERRO ao preparar os discos." \
    "  Entre como 'admin' e veja: sudo cat $LOG" "" > /etc/issue
  agetty --reload >/dev/null 2>&1 || true
  exit 1
fi
